         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">MC74HC14A - Hex Schmitt-Trigger Inverter High-Performance Silicon-Gate CMOS</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The MC74HC14A/MC74HCT14A is useful to â€œsquare upâ€ slow&#xA;input rise and fall times. Due to hysteresis voltage of the Schmitt&#xA;trigger, the device finds applications in noisy environments. The&#xA;MC74HC14A has CMOSâˆ’level input thresholds while the&#xA;MC74HCT14A has TTLâˆ’Level input thresholds.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:17fcbac4-b84e-4fee-8eaa-6f73109049da</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:547ac724-2b77-4cbe-a580-dc9e243aa696</xmpMM:InstanceID>
      </rdf:Description>
